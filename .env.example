# Copy to .env and replace every placeholder. Never commit .env.
# Placeholders only: no real credentials, hosts or customer data.

POSTGRES_USER=abhiyogah
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abhiyogah

# Used by api, worker and the `db`-marked tests. Inside docker compose the host is "postgres".
DATABASE_URL=postgresql+psycopg://abhiyogah:change-me@postgres:5432/abhiyogah

# Logging
LOG_LEVEL=INFO

# LLM gateway (perception stream). Leave empty to run rules-only.
LLM_PROVIDER=
LLM_ENDPOINT=
LLM_API_KEY=
