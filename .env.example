# Copy to .env and replace every placeholder. Never commit .env.
# Placeholders only: no real credentials, hosts or customer data.

POSTGRES_USER=abhiyogah
POSTGRES_PASSWORD=change-me
POSTGRES_DB=abhiyogah

# Used by api, worker and the `db`-marked tests. Inside docker compose the host is "postgres".
DATABASE_URL=postgresql+psycopg://abhiyogah:change-me@postgres:5432/abhiyogah

# Engine API and worker (see src/abhiyogah/api/settings.py).
# API keys: "<actor>:<role>:<key>;..." with role reader, writer or admin. Empty: every call is 401.
# Generate your own long random keys; `make demo` makes fresh ones per run.
ABHIYOGAH_API_KEYS=
ABHIYOGAH_RULES_DIR=rules/obligations
# Entity profile as JSON, e.g. {"entity_type": "COMMERCIAL_BANK", "outlets": 120,
# "outlets_as_on": "2025-03-31", "home_branch_state": "MH"}. Empty: a commercial bank with an
# unknown outlet count, so outlet-gated obligations report INSUFFICIENT_FACTS.
ABHIYOGAH_PROFILE=
ABHIYOGAH_REEVALUATE_MINUTES=15

# Logging
LOG_LEVEL=INFO

# LLM gateway (perception stream). Leave empty to run rules-only.
LLM_PROVIDER=
LLM_MODEL=
# Keep data in India: an India region (e.g. ap-south-1) unless this is deliberately lifted.
LLM_REGION=
LLM_ALLOW_NON_INDIA_REGION=false
LLM_ENDPOINT=
LLM_API_KEY=
LLM_REASONING_EFFORT=low
