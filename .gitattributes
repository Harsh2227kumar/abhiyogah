# Same bytes on every OS. Calendar and rule files are hashed into decision records
# (calendar_version), and the source tree is bind-mounted into Linux containers, so a Windows
# checkout must not turn LF into CRLF.
* text=auto eol=lf

# Windows batch files need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

*.pdf binary
*.png binary
*.jpg binary
*.ico binary
